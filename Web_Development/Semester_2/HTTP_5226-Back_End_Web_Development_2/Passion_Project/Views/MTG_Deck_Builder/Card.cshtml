
@{
    Layout = "_Layout";  // This tells the view to use the _Layout.cshtml file
    string deckID = ViewData["DeckID"] as string; // Retrieve the subtitle from ViewData
}

@section Styles {
<style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f7f7f7;
            margin: 0;
            padding: 0;
        }

        .user-view {
            background-color: rgba(0, 0, 0, 0.05);
            padding: 20px;
        }

        /* Styling for the header */
        .display-4 {
            margin-bottom: 20px;
            color: #333;
        }

        /* Search Bar Styling */
        .search-container {
            position: relative;
            margin-bottom: 20px;
            padding: 10px;
        }

        #search-bar {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        /* Updated dropdown list to appear above the search bar */

        /* Updated dropdown list to appear below the search bar */
        .dropdown-list {
            list-style-type: none;
            margin: 0;
            padding: 0;
            position: absolute;
            top: 100%; /* Position the dropdown below the search bar */
            left: 0;
            right: 0;
            background-color: rgba(255, 255, 255, 0.9); /* White with some transparency */
            border: 1px solid #ccc;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 10;
            display: none; /* Hidden by default */
            max-height: 200px; /* Optional: limit height of dropdown */
            overflow-y: auto; /* Scroll if content exceeds the max-height */
        }


        .dropdown-item {
            padding: 10px;
            cursor: pointer;
            border-bottom: 1px solid #f1f1f1;
        }

        .dropdown-item:hover {
            background-color: #f0f0f0;
        }
    
        #cards-list {
            display: flex;
            flex-wrap: wrap;
            gap: 20px; /* Space between cards */
            justify-content: flex-start; /* Align cards from the start */
        }

        .card .btn-add,
        .card .btn-remove {
            position: absolute;
            top: 10px; /* Distance from the top of the card */
            padding: 15px 30px; /* Increase button size */
            font-size: 16px; /* Make the text bigger */
            border: none;
            border-radius: 8px; /* Rounded edges */
            background-color: #007bff;
            color: white;
            cursor: pointer;
            z-index: 10;
            transition: background-color 0.3s ease;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Subtle shadow for visibility */
        }

        .card .btn-add {
            left: 10px; /* Position the Add button at the left */
        }

        .card .btn-remove {
            right: 10px; /* Position the Remove button at the right */
        }

        .card .btn-add:hover,
        .card .btn-remove:hover {
            background-color: #0056b3;
        }

        /* Button Styling */
        #button-group {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
        }        

        button {
            padding: 8px 12px;
            font-size: 14px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            margin: 0 5px; /* Add spacing between buttons */
        }

        button:hover {
            background-color: #0056b3;
        }

        button:disabled {
            background-color: #ccc; /* Disabled button styling */
            cursor: not-allowed;
        }

        /* Styling for alerts */
        .alert {
            padding: 15px;
            margin-bottom: 20px;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border-color: #c3e6cb;
        }

        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            border-color: #ffeeba;
        }

        #advanced-search {
            display: flex;
            flex-direction: column;
            @* justify-content: space-between; *@
            justify-content: flex-start; /* Align items to the start of the container */
            @* align-items: center; /* Center horizontally */ *@
            align-items: left; /* Center horizontally */

            margin-top: 10px;
            background-color: slategrey;
            border-radius: 10px;
            padding: 5px;
            margin-top: 10px;
            text-align: left;
        }

        .underlined-header {
            text-align: left;
            display: inline-block;
            position: relative;
            padding-bottom: 5px; /* Adjusts the space between text and underline */
        }

        .underlined-header::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px; /* Adjusts the thickness of the underline */
            background-color: black; /* Adjust the color of the underline */
        }


    </style>    
}
